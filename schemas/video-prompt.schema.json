{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://postpilot.local/schemas/video-prompt.schema.json",
  "title": "PostPilotVideoPrompt",
  "type": "object",
  "additionalProperties": false,
  "required": ["subject", "scene", "sound", "shots"],
  "properties": {
    "subject": { "type": "string", "minLength": 2, "description": "主体；优先引用持久化角色资产" },
    "scene": { "type": "string", "minLength": 2, "description": "场景；优先引用场景参考图" },
    "sound": { "type": "string", "minLength": 2, "description": "仅环境音和拟音，禁止BGM" },
    "shots": {
      "type": "array", "minItems": 1, "maxItems": 8,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["framing", "action"],
        "properties": { "framing": { "type": "string" }, "action": { "type": "string", "minLength": 2 } }
      }
    }
  }
}
